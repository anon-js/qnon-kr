---
import { cn } from "@/lib/utils";

interface Props {
  id: string;
  title: string;
  description?: string;
  class?: string;
  titleClass?: string;
  descriptionClass?: string;
}

const { id, title, class: sectionClass, titleClass } = Astro.props;
---

<section
  id={id}
  class={cn(
    "flex flex-col items-start justify-center w-full gap-6 px-8 py-16 md:px-14",
    sectionClass,
  )}
  aria-labelledby={`${id}-title`}
>
  {
    (
      <h2
        id={`${id}-title`}
        class={cn("text-xl font-medium text-gray-600", titleClass)}
        set:html={title}
      />
    )
  }
  <slot />
</section>
