---
import { Image } from "astro:assets";

interface Props {
  name: string;
  description: string;
  href: string;
  img?: string;
}

const { name, description, href, img } = Astro.props;
---

<article>
  <a
    class="group relative flex flex-col gap-2 rounded-lg outline-2 outline-offset-8 outline-transparent transition-colors duration-250 hover:outline-blue-500 focus:outline-blue-500 max-sm:pb-4 sm:flex-row"
  >
    <figure
      class="aspect-video max-h-78.25 min-h-22.5 w-full max-w-139.25 min-w-40 overflow-hidden rounded-xl border border-gray-300 bg-gray-200 sm:max-h-40.5 sm:max-w-72"
      transition:name=`project-${name}-image`
    >
      {
        img && (
          <Image
            src={img}
            alt={name}
            width={1280}
            height={720}
            class="h-full w-full object-cover"
          />
        )
      }
    </figure>
    <div class="flex flex-col items-start justify-center gap-1 px-4">
      <h3
        class="text-3xl font-bold text-gray-800"
        transition:name=`project-${name}-title`
      >
        {name}
      </h3>
      <p
        class="text-base text-gray-600"
        transition:name=`project-${name}-description`
      >
        {description}
      </p>
    </div>
  </a>
</article>
