---
import { cn } from "@/lib/utils";

interface Props {
  class?: string;
}

interface NavItem {
  name: string;
  href: string;
}

const navItems: NavItem[] = [
  { name: "소개", href: "#about" },
  { name: "프로젝트", href: "#project" },
  { name: "기술", href: "#skills" },
  { name: "경험", href: "#experience" },
];

const { class: className } = Astro.props;
---

<nav
  class={cn(
    "glass flex flex-row items-center justify-center gap-2 px-4 py-1",
    className,
  )}
>
  <ul class="flex flex-row gap-2 text-lg font-medium">
    {
      navItems.map((item) => (
        <li class="link w-full list-none">
          <a href={item.href} class="block rounded-xl px-4 py-2">
            {item.name}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
